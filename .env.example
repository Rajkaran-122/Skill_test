# ============================================================
# Store Intelligence Platform (SIP) — Environment Configuration
# ============================================================
# Copy this file to .env and update values for your environment.
# NEVER commit .env to version control.
# ============================================================

# ---- General ----
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ---- PostgreSQL + TimescaleDB ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=sip_db
POSTGRES_USER=sip_user
POSTGRES_PASSWORD=change_me_in_production
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# ---- Kafka ----
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_GROUP_ID_PREFIX=sip

# ---- FastAPI ----
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- JWT Authentication ----
JWT_SECRET_KEY=change_this_to_a_secure_random_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---- API Keys ----
API_KEY_HEADER=X-API-Key
API_KEYS=dev_key_change_me

# ---- CV Pipeline ----
YOLO_MODEL=yolo11n.pt
YOLO_CONFIDENCE_THRESHOLD=0.5
YOLO_DEVICE=cpu
BYTETRACK_TRACK_THRESH=0.5
BYTETRACK_MATCH_THRESH=0.8
OSNET_MODEL=osnet_x1_0
OSNET_SIMILARITY_THRESHOLD=0.7
REID_GALLERY_TTL_SECONDS=7200
REID_GALLERY_MAX_SIZE=10000
VIDEO_SOURCE=0
VIDEO_FPS=20

# ---- Queue Detection ----
QUEUE_ZONE_IDS=CHECKOUT
QUEUE_ALERT_THRESHOLD=10
QUEUE_ABANDON_TIMEOUT_SECONDS=300

# ---- Anomaly Detection ----
ANOMALY_SIGMA_THRESHOLD=3.0
ANOMALY_DEAD_ZONE_MINUTES=30
ANOMALY_CAMERA_HEARTBEAT_TIMEOUT_SECONDS=60

# ---- Prometheus ----
PROMETHEUS_PORT=9090

# ---- Grafana ----
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ---- Dashboard ----
DASHBOARD_PORT=3000
VITE_API_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/api/v1/ws
